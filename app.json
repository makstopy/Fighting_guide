{
  "expo": {
    "name": "Fighting Guide",
    "slug": "Fighting-guide-expo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "scheme": "fightingguideexpo",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0a0f",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0a0a0f"
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "backgroundColor": "#0a0a0f",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0a0a0f"
    },
    "android": {
      "package": "com.makstopy.fightingguide",
      "backgroundColor": "#0a0a0f",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/images/app_icon.png",
        "backgroundImage": "./assets/images/app_icon.png",
        "monochromeImage": "./assets/images/app_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0f"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14222150-d12f-436f-950c-fbcadea259b3"
      }
    }
  }
}
